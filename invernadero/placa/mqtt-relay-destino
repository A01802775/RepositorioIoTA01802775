#!/bin/bash
# -----------------------------------------------------------------------------
#  mqtt-relay-destino — se ejecuta en el Linux del UNO Q por cada conexión MQTT
#
#  Conecta la conexión entrante (del contenedor main.py) con el Mosquitto de
#  Docker Desktop en la compu. Prueba los caminos en este orden y usa el
#  primero que responda:
#
#   1) IP fija escrita en /etc/mqtt-broker (opcional, una sola línea)
#   2) WiFi: hotspot de Windows en la compu -> siempre 192.168.137.1
#   3) Cable USB: la IP que la placa le dio a la compu por usb0 (respaldo)
#
#  ¿Por qué existe? NetworkManager (modo "compartido" de usb0) rechaza el
#  tráfico que los contenedores mandan hacia usb0, y además la IP de la
#  compu cambia. El Linux de la placa sí puede salir, así que el contenedor
#  le habla a este repetidor y el repetidor reenvía.
# -----------------------------------------------------------------------------
PUERTO=1883
CANDIDATOS=()

# 1) IP fija configurada a mano
if [ -r /etc/mqtt-broker ]; then
    FIJA=$(head -n 1 /etc/mqtt-broker | tr -d '[:space:]')
    [ -n "$FIJA" ] && CANDIDATOS+=("$FIJA")
fi

# 2) Hotspot de Windows (la compu es el punto de acceso)
CANDIDATOS+=("192.168.137.1")

# 3) Cable USB: concesión DHCP más reciente de usb0
LEASES=/var/lib/NetworkManager/dnsmasq-usb0.leases
if [ -r "$LEASES" ]; then
    USB=$(sort -n "$LEASES" | tail -n 1 | awk '{print $3}')
    [ -n "$USB" ] && CANDIDATOS+=("$USB")
fi

for IP in "${CANDIDATOS[@]}"; do
    if timeout 1 bash -c "</dev/tcp/$IP/$PUERTO" 2>/dev/null; then
        logger -t mqtt-relay "Conexión MQTT reenviada a $IP:$PUERTO"
        exec socat - TCP:"$IP":"$PUERTO",connect-timeout=5
    fi
done

logger -t mqtt-relay "Ningún broker respondió (probé: ${CANDIDATOS[*]})"
exit 1
