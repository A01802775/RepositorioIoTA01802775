# Configuración del servidor del invernadero (NO se sube a GitHub).

# --- SQL Server del profe (contenedor "mssql" en Docker Desktop) ---
# "mssql" = nombre del contenedor en la red de Docker "tc1004b" de la clase.
MSSQL_HOST=mssql
MSSQL_PORT=1433
MSSQL_USER=sa
MSSQL_PASSWORD=PON_AQUI_LA_CONTRASEÑA_DE_SA
MSSQL_DATABASE=invernadero

# --- Grafana (http://localhost:3000) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=PON_AQUI_TU_CONTRASEÑA
