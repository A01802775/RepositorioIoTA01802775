      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "mssql-invernadero"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- Conectado = llegó una lectura en los últimos 20 s (la placa manda una cada 5 s)\nSELECT CASE WHEN DATEDIFF(SECOND, MAX(ts), SYSUTCDATETIME()) <= 20 THEN 1 ELSE 0 END AS conectado\nFROM lecturas WHERE nodo = '$nodo'"
        }
      ],
      "fieldConfig": {
        "defaults": {
