            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto"
      },
      "description": "Último estado reportado por MQTT en invernadero/<nodo>/estado. Puede tardar ~45 s en pasar a OFFLINE (keepalive de 30 s x 1.5)."
    },
    {
      "id": 12,
      "type": "state-timeline",
      "title": "Historial de conexión del Arduino",
      "datasource": {
        "type": "mssql",
        "uid": "mssql-invernadero"
      },
      "gridPos": {
        "h": 5,
        "w": 16,
        "x": 8,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "mssql-invernadero"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- 1 = llegaban lecturas, 0 = hueco de más de 20 s sin lecturas\nWITH l AS (\n  SELECT ts, LAG(ts) OVER (ORDER BY ts) AS prev\n  FROM lecturas WHERE nodo = '$nodo' AND $__timeFilter(ts)\n)\nSELECT time, Arduino FROM (\n  SELECT ts AS time, 1 AS Arduino FROM l\n  UNION ALL\n  SELECT DATEADD(SECOND, 10, prev), 0 FROM l WHERE DATEDIFF(SECOND, prev, ts) > 20\n  UNION ALL\n  SELECT DATEADD(SECOND, 10, MAX(ts)), 0 FROM l\n  HAVING DATEDIFF(SECOND, MAX(ts), SYSUTCDATETIME()) > 20\n) t\nORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Desconectado",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Conectado",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.8,
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
