    {
      "id": 13,
      "type": "stat",
      "title": "📟 Pantalla del Arduino (lo que dice la LCD)",
      "datasource": {
        "type": "mssql",
        "uid": "mssql-invernadero"
      },
      "description": "Retransmite el mensaje de la mini interfaz de la LCD: alarma, sensores no detectados, todo normal o Arduino no conectado.",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "mssql-invernadero"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- Lo mismo que dice la LCD. Si no llegan datos en 20 s: Arduino no conectado\nSELECT CASE\n         WHEN u.ts IS NULL OR DATEDIFF(SECOND, u.ts, SYSUTCDATETIME()) > 20\n           THEN N'❌ Arduino no conectado'\n         ELSE COALESCE(u.mensaje, N'Sin mensaje (graba el sketch nuevo con S1)')\n       END AS mensaje\nFROM (SELECT 1 AS x) AS d\nLEFT JOIN (SELECT TOP 1 ts, mensaje FROM lecturas WHERE nodo = '$nodo' ORDER BY ts DESC) AS u ON 1 = 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#5A5A5A"
          },
          "mappings": [
            {
              "type": "regex",
              "options": {
                "pattern": "^🚨.*",
                "result": {
                  "color": "red",
                  "index": 0
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^⚠.*",
                "result": {
                  "color": "orange",
                  "index": 1
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^✅.*",
                "result": {
                  "color": "green",
                  "index": 2
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^❌.*",
                "result": {
                  "color": "#5A5A5A",
                  "index": 3
                }
              }
            },
            {
              "type": "regex",
              "options": {
                "pattern": "^🔌.*",
                "result": {
                  "color": "blue",
                  "index": 4
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^mensaje$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "orientation": "auto",
        "text": {
          "valueSize": 30
        }
      }
    },
