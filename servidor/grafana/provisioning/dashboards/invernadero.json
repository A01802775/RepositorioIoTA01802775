          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT TOP 20 ts AS [Hora], nodo AS [Nodo], temperatura AS [Temp °C], humedad AS [Hum %],\n       nivel_agua AS [Agua %], luz AS [Luz %], CASE WHEN alarma = 1 THEN 'ALARMA' ELSE 'OK' END AS [Estado]\nFROM lecturas\nWHERE nodo = '$nodo'\nORDER BY ts DESC"
