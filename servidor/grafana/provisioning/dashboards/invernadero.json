          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- Solo los CAMBIOS de estado (no cada lectura) + conexiones/desconexiones\nWITH m AS (\n  SELECT ts, codigo, sensores, mensaje,\n         LAG(codigo)   OVER (ORDER BY ts) AS codigo_prev,\n         LAG(sensores) OVER (ORDER BY ts) AS sensores_prev\n  FROM lecturas\n  WHERE nodo = '$nodo' AND $__timeFilter(ts) AND mensaje IS NOT NULL\n)\nSELECT TOP 20 Hora, Mensaje FROM (\n  SELECT ts AS Hora, mensaje AS Mensaje FROM m\n  WHERE codigo_prev IS NULL OR codigo <> codigo_prev OR sensores <> sensores_prev\n  UNION ALL\n  SELECT ts, CASE estado WHEN 'online' THEN N'🔌 Arduino conectado (MQTT online)'\n                         ELSE N'❌ Arduino no conectado (MQTT offline)' END\n  FROM conexiones WHERE nodo = '$nodo' AND $__timeFilter(ts)\n) AS t\nORDER BY Hora DESC"
        }
