    {
      "id": 11,
      "type": "stat",
      "title": "📶 MQTT (Last Will)",
      "datasource": {
        "type": "mssql",
        "uid": "mssql-invernadero"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mssql",
            "uid": "mssql-invernadero"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "-- 'online' lo publica la placa al conectarse; 'offline' lo publica Mosquitto\n-- (Last Will) cuando la placa se desconecta sin avisar\nSELECT TOP 1 CASE estado WHEN 'online' THEN 1 ELSE 0 END AS mqtt\nFROM conexiones WHERE nodo = '$nodo' ORDER BY ts DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "color": {
